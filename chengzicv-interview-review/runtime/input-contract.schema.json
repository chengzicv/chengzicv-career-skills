{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["runtime_mode", "task_mode", "session_state", "messages"],
  "additionalProperties": false,
  "properties": {
    "runtime_mode": {"const": "product"},
    "task_mode": {"enum": ["diagnosis_report", "interview_experience_deconstruction", "full_review"]},
    "resume_text": {"type": ["string", "null"]},
    "jd_text": {"type": ["string", "null"]},
    "target_role": {"type": ["string", "null"]},
    "company_name": {"type": ["string", "null"]},
    "company_type": {"type": ["string", "null"]},
    "session_state": {
      "type": "object",
      "required": ["session_id", "status", "skill_version"],
      "additionalProperties": false,
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["not_started", "evidence_complete", "report_complete", "deconstruction_complete", "complete"]},
        "skill_version": {"const": "review-v1"}
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["message_id", "role", "content"],
        "additionalProperties": false,
        "properties": {
          "message_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["user", "assistant", "system"]},
          "content": {"type": "string"}
        }
      }
    }
  }
}

